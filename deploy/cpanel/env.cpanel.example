# Shop.co API settings for shared hosting. Save a copy as .env in the API folder (shopco-api/.env),
# fill in each value marked <...>, and never upload it anywhere public. deploy/cpanel/README.md explains each.

APP_NAME="Shop.co"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# The shop's public address, as shoppers see it (the storefront), not the API's.
APP_URL=https://<shop address>
FRONTEND_URL=https://<shop address>
CORS_ALLOWED_ORIGINS=https://<shop address>

# cPanel puts your account name in front of both, for example myacc_shopco.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<account>_shopco
DB_USERNAME=<account>_shopco
DB_PASSWORD=<database password>

# The storefront's own address as the API sees it. Start with 127.0.0.1,::1 then add what
# admin, System status, "Visitor addresses" shows (README step 7).
TRUSTED_PROXIES=127.0.0.1,::1

STORE_WHATSAPP_PHONE=<for example 2348012345678>
PAYMENT_WHATSAPP_ENABLED=true
PAYMENT_MONNIFY_ENABLED=false
PAYMENT_KORA_ENABLED=false

# Pictures: the same bucket and keys as your PC shop.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=shopco-media
S3_ACCESS_KEY_ID=<key id>
S3_SECRET_ACCESS_KEY=<secret>
S3_PREFIX=uploads/
S3_PATH_STYLE=true
BACKUP_S3_PREFIX=backups/
# Shared hosting often limits disk and the number of files, so pictures stay only in the bucket.
BACKUP_PICTURES=false

# log = written to storage/logs/mail.log. For real email: resend, RESEND_API_KEY, MAIL_FROM_ADDRESS.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Shop.co"

# Lets an admin change refresh the shop's pages at once. The same value goes in the Node.js app.
STOREFRONT_REVALIDATE_URL=https://<shop address>/api/revalidate
REVALIDATE_SECRET=<a random value of at least 32 characters>

# Off on shared hosting: each open payment page would hold one of your few PHP processes.
SSE_ENABLED=false
REDIS_URL=
