# Shop.co scheduled jobs (/etc/cron.d/shopco, installed by deploy/oracle/setup.sh). They run as
# www-data, like the API, so files they write stay usable by it. Output: backend/storage/logs/jobs.log
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOG=__APP__/backend/storage/logs/jobs.log

# Emails waiting to be sent: every minute.
* * * * *     www-data  php __APP__/backend/scripts/process_outbox.php --limit=500 --max-seconds=50 --rate=8 >> $LOG 2>&1
# Unpaid orders past their time limit: every 10 minutes.
*/10 * * * *  www-data  php __APP__/backend/scripts/expire_pending_orders.php >> $LOG 2>&1
# Database check: daily at 03:00.
0 3 * * *     www-data  php __APP__/backend/scripts/check_database.php >> $LOG 2>&1
# Backup, then a copy of it in the R2 bucket (backups/ folder, never shown by the shop): 02:30.
30 2 * * *    www-data  php __APP__/backend/scripts/backup.php >> $LOG 2>&1 && php __APP__/backend/scripts/backup_to_bucket.php >> $LOG 2>&1
