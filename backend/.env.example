# -----------------------------------------------------------------------------
# Shop.co E-Commerce Backend Environment Configuration
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control. Placeholders only in this file.
# -----------------------------------------------------------------------------

# Application
APP_NAME="Shop.co API"
APP_ENV=development            # development | production (production forces Secure cookies, hides debug output)
APP_DEBUG=true                 # ignored when APP_ENV=production
APP_TIMEZONE=Africa/Lagos
APP_URL=http://127.0.0.1:8000  # public URL of this API (used for gateway webhook URLs)
FRONTEND_URL=http://localhost:3000  # storefront origin (email links, payment return URLs)

# Database (local XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopco_dev
DB_USERNAME=root
DB_PASSWORD=

# Store
STORE_CURRENCY=NGN
STORE_ORIGIN_CITY=
STORE_ORIGIN_STATE=
STORE_WHATSAPP_PHONE=

# CORS: exact frontend origins, comma-separated, no trailing slash.
# The storefront normally calls the API through the Next.js /api/v1 proxy (same origin),
# so this only matters for direct cross-origin calls.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Proxies whose X-Forwarded-For header is trusted for client IPs (the Next.js server).
TRUSTED_PROXIES=127.0.0.1,::1

# Sessions (HTTP-only cookies; admin and customer sessions are separate)
SESSION_COOKIE_NAME=shopco_session
SESSION_LIFETIME_SECONDS=2592000        # customer: 30 days
ADMIN_SESSION_LIFETIME_SECONDS=43200    # admin: 12 hours absolute
ADMIN_SESSION_IDLE_SECONDS=7200         # admin: signed out after 2 hours idle

# Payment methods the server allows (the admin can also switch each one off in Store settings)
PAYMENT_MONNIFY_ENABLED=true
PAYMENT_KORA_ENABLED=true
PAYMENT_WHATSAPP_ENABLED=true

# Public catalogue cache (homepage, filters, categories, listing pages) in seconds; 0 = off.
# Admin changes clear it immediately; stock/sales shown on lists can be this old.
CATALOG_CACHE_SECONDS=60

# After an admin change, ask the storefront to rebuild its cached pages at once (otherwise
# they refresh within about a minute). The URL must be reachable from this server; the secret
# must match REVALIDATE_SECRET in the storefront's .env.local (at least 32 characters).
# Leave either empty to switch it off. The last attempt is shown in admin → System status.
# Example: STOREFRONT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
STOREFRONT_REVALIDATE_URL=
REVALIDATE_SECRET=

# API requests slower than this (milliseconds) are counted for the "site is slow" alert in
# admin → Data & storage; 0 = off. How long data is kept is set in that admin screen.
SLOW_REQUEST_MS=1500

# Uploaded pictures folder (default backend/public/uploads, served at /uploads). Leave empty.
UPLOAD_DIR=
# scripts/backup.php: where backups go (default backend/storage/backups) and, if mysqldump is not
# on PATH (or in XAMPP's folder on Windows), its full path.
BACKUP_DIR=
MYSQLDUMP_PATH=

# Kora (Korapay) sandbox credentials
KORA_API_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=pk_test_placeholder
KORA_SECRET_KEY=sk_test_placeholder
KORA_WEBHOOK_SECRET=

# Monnify sandbox credentials
MONNIFY_API_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=

# Email. MAIL_MAILER=log writes every email to storage/logs/mail.log (nothing is delivered).
# MAIL_MAILER=resend sends through Resend's API (RESEND_API_KEY, and MAIL_FROM_ADDRESS on a
# domain verified in Resend). MAIL_MAILER=smtp uses the MAIL_HOST/PORT/credentials below.
# MAIL_ENCRYPTION (SMTP only): tls (STARTTLS, usually port 587), ssl (port 465) or none.
MAIL_MAILER=log
# Resend API key (server-only: never put it in the storefront's .env.local or any NEXT_PUBLIC_ value).
RESEND_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Shop.co"
# Order, payment and shipping emails get one quick attempt right after the response has been sent
# (nobody waits for the mail server); false leaves them all to scripts/process_outbox.php, which
# also sends retries and newsletters. Schedule it every minute either way.
MAIL_SEND_IMMEDIATELY=true
# Seconds to wait for the mail server to connect and to answer each step (2-60).
MAIL_TIMEOUT_SECONDS=10
# Retry due emails after API requests (at most 5 a minute, never twice), so retries work
# even before process_outbox.php is scheduled. false = leave retries to the worker only.
MAIL_AUTO_RETRY=true
# Where log-mode email is written (relative to backend/).
MAIL_LOG_PATH=storage/logs/mail.log
