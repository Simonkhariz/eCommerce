# -----------------------------------------------------------------------------
# Shop.co E-Commerce Backend Environment Configuration
# Copy this file to .env and customize values for local development.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME="Shop.co REST API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Local XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopco_dev
DB_USERNAME=root
DB_PASSWORD=""

# Store Settings (Origin & Currency)
STORE_NAME="SHOP.CO"
STORE_CURRENCY=NGN
STORE_ORIGIN_CITY=Enugu
STORE_ORIGIN_STATE=Enugu

# CORS Settings (Allowed frontend origins, comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Kora (Korapay) Sandbox Credentials (Populated in Step 9)
KORA_API_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=pk_test_placeholder
KORA_SECRET_KEY=sk_test_placeholder
KORA_ENCRYPTION_KEY=ek_test_placeholder
KORA_WEBHOOK_SECRET=whsec_test_placeholder

# Session & Security Settings
SESSION_COOKIE_NAME=shopco_session
SESSION_LIFETIME_SECONDS=86400
ADMIN_SETUP_LOCKED=false
