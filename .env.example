# -----------------------------------------------------------------------------
# Shop.co Storefront (Next.js) Environment Configuration
# NEVER put server secrets, private API keys, or credentials in NEXT_PUBLIC_* variables.
# -----------------------------------------------------------------------------

# Server-only: where the PHP API runs. The browser calls same-origin /api/v1 and /uploads,
# which Next.js proxies to this origin, so session cookies stay HTTP-only and same-site.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Server-only: lets the PHP API refresh cached shop pages straight after an admin change
# (POST /api/revalidate). Use a random value of at least 32 characters, the same as
# REVALIDATE_SECRET in backend/.env, e.g. from: php -r "echo bin2hex(random_bytes(24));"
# Leave empty to switch it off: pages then refresh on their own within about a minute.
REVALIDATE_SECRET=

# Optional override for the browser-facing API base. Leave unset to use the /api/v1 proxy
# (required for cookie sign-in to work).
# NEXT_PUBLIC_API_BASE_URL=/api/v1
